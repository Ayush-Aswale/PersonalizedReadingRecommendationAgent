# ============================================================
# Personalized Reading Recommendation Agent — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git!

# --- Groq LLM (SERVER-SIDE ONLY — never expose to frontend) ---
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b

# --- Local development storage ---
DATABASE_PATH=database/app.db
CHROMA_PERSIST_DIR=database/chroma

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Agent behavior ---
CONVERSATION_MEMORY_WINDOW=8
MAX_AGENT_ITERATIONS=6
MAX_RECOMMENDATIONS=5

# --- Production / Vercel deployment (leave blank for local dev) ---
# DATABASE_URL=postgresql://user:pass@host/dbname
# VECTOR_STORE_URL=
# VECTOR_STORE_API_KEY=
